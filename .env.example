# ── Supabase (Settings → API) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Settings → Database → Connection string (Session pooler) — used by `npm run db:apply`
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Gemini (billed key, pinned late-2026 models; zero gemini-2.5 references) ──
GEMINI_API_KEY=
AI_FAST_MODEL=gemini-3.5-flash-lite
AI_AGENT_MODEL=gemini-3.8-flash
# optional secondary model used on timeout / 429
AI_FALLBACK_MODEL=
AI_TTS_MODEL=gemini-3.8-flash-lite-tts
AI_TIMEOUT_MS=6000

# ── Generated by `npm run setup` ───────────────────────────────────────────
ED25519_PRIVATE_KEY=
NEXT_PUBLIC_ED25519_PUBLIC_KEY=
DEMO_RESET_SECRET=
STAGE_EMAIL=stage@dukaanos.pk
STAGE_PASSWORD=

# public origin used in the Passport QR (/verify link)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudflare Turnstile (bot protection on public sandbox creation) ────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI daily cost quotas (CFO controls, env-tunable) ────────────────────────
AI_DAILY_CAP_VOICE=400
AI_DAILY_CAP_PARCHI=30
AI_DAILY_CAP_QA=60
AI_DAILY_CAP_TTS=60
AI_GLOBAL_DAILY_PKR_CAP=5000

# ── App config & cron ───────────────────────────────────────────────────────
MIN_SUPPORTED_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
CRON_SECRET=

